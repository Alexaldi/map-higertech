APP_NAME=Higertech
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---- Database MySQL ----
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=higertech
DB_USERNAME=root
DB_PASSWORD=
DB_ROOT_PASSWORD=secret123

# ---- Session & Cache ----
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Gunakan 'database' untuk local tanpa docker, atau 'redis' jika menggunakan docker/vps
QUEUE_CONNECTION=database
CACHE_STORE=file
CACHE_PREFIX=higertech_

# ---- Redis Configuration ----
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@higertech.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---- Admin Credentials (for db:seed AdminUserSeeder) ----
ADMIN_EMAIL=admin@higertech.com
ADMIN_PASSWORD=password123

# ---- WhatsApp Gateway (GOWA) ----
# Local dev: http://localhost:3000 | Docker: http://gowa:3000
GOWA_API_URL=http://localhost:3000
GOWA_DEVICE_ID=default
GOWA_BASIC_AUTH_USERNAME=admin
GOWA_BASIC_AUTH_PASSWORD=passwordGowa123
WHATSAPP_ADMIN_NUMBER=08123456789

VITE_APP_NAME="${APP_NAME}"
